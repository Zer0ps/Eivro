+package main
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+
+	"github.com/sagernet/sing-box/experimental/cachefile"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	mainCommand.AddCommand(&cobra.Command{
+		Use:    "eivro-retire-fakeip SOURCE_FD TARGET_FD",
+		Hidden: true, SilenceUsage: true, SilenceErrors: true,
+		Args:             cobra.ExactArgs(2),
+		PersistentPreRun: func(*cobra.Command, []string) {},
+		RunE: func(_ *cobra.Command, args []string) error {
+			var paths [2]string
+			for i, arg := range args {
+				fd, err := strconv.Atoi(arg)
+				if err != nil || fd < 3 {
+					return errors.New("invalid inherited state descriptor")
+				}
+				paths[i] = fmt.Sprintf("/proc/self/fd/%d", fd)
+			}
+			return cachefile.RetireFakeIP(paths[0], paths[1])
+		},
+	})
+}
