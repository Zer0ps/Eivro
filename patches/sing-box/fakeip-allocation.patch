+package fakeip
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/netip"
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/logger"
+)
+
+type checkedStorage struct {
+	*MemoryStorage
+	cursor                  *adapter.FakeIPMetadata
+	failCursor, failMapping bool
+}
+
+func (s *checkedStorage) FakeIPSaveMetadata(m *adapter.FakeIPMetadata) error {
+	if s.failCursor {
+		return errors.New("cursor unavailable")
+	}
+	copy := *m
+	s.cursor = &copy
+	return nil
+}
+func (s *checkedStorage) FakeIPStore(a netip.Addr, domain string) error {
+	if s.cursor == nil || (a.Is4() && s.cursor.Inet4Current != a) || (a.Is6() && s.cursor.Inet6Current != a) {
+		return errors.New("mapping published before cursor reservation")
+	}
+	if s.failMapping {
+		return errors.New("mapping unavailable")
+	}
+	return s.MemoryStorage.FakeIPStore(a, domain)
+}
+func testStore() (*Store, *checkedStorage) {
+	s := NewStore(context.Background(), logger.NOP(), netip.MustParsePrefix("198.18.0.0/29"), netip.MustParsePrefix("2001:2::/125"))
+	storage := &checkedStorage{MemoryStorage: NewMemoryStorage()}
+	s.storage = storage
+	s.inet4Current = s.inet4Range.Addr().Next()
+	s.inet6Current = s.inet6Range.Addr().Next()
+	return s, storage
+}
+func TestEivroFailedStateNeverReturnsAnUnrecordedAddress(t *testing.T) {
+	for _, cursorFailure := range []bool{true, false} {
+		t.Run(fmt.Sprint(cursorFailure), func(t *testing.T) {
+			s, storage := testStore()
+			storage.failCursor = cursorFailure
+			storage.failMapping = !cursorFailure
+			if a, err := s.Create("failed.test", false); err == nil || a.IsValid() {
+				t.Fatal("returned an unrecorded address", a, err)
+			}
+			if _, exists := storage.FakeIPLoadDomain("failed.test", false); exists {
+				t.Fatal("failed mapping became visible")
+			}
+			storage.failCursor, storage.failMapping = false, false
+			a, err := s.Create("next.test", false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if a != netip.MustParseAddr("198.18.0.3") {
+				t.Fatal("reserved address was reused", a)
+			}
+		})
+	}
+}
+func TestEivroExhaustionPreservesBothFamilies(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		t.Run(fmt.Sprint(ipv6), func(t *testing.T) {
+			s, _ := testStore()
+			var first netip.Addr
+			for i := 0; i < 5; i++ {
+				a, err := s.Create(fmt.Sprintf("name-%d.test", i), ipv6)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if i == 0 {
+					first = a
+				}
+			}
+			if a, err := s.Create("exhausted.test", ipv6); err == nil || a.IsValid() {
+				t.Fatal("exhaustion reused an address", a, err)
+			}
+			if domain, ok := s.Lookup(first); !ok || domain != "name-0.test" {
+				t.Fatal("old address changed identity", domain)
+			}
+		})
+	}
+}
+func TestEivroConcurrentSameDomainKeepsOneIdentity(t *testing.T) {
+	s, _ := testStore()
+	var group sync.WaitGroup
+	for range 32 {
+		group.Go(func() {
+			a, err := s.Create("same.test", false)
+			if err != nil || a != netip.MustParseAddr("198.18.0.2") {
+				t.Errorf("inconsistent identity: %v %v", a, err)
+			}
+		})
+	}
+	group.Wait()
+	a, err := s.Create("next.test", false)
+	if err != nil || a != netip.MustParseAddr("198.18.0.3") {
+		t.Fatal("duplicate allocation", a, err)
+	}
+}
