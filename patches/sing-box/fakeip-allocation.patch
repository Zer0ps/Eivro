+func TestEivroCursorReadIsNonDestructiveAndMissingCursorIsNotEmptyState(t *testing.T) {
+	c := New(context.Background(), logger.NOP(), option.CacheFileOptions{Path: filepath.Join(t.TempDir(), "cache.db"), StoreFakeIP: true})
+	if err := c.start(); err != nil {
+		t.Fatal(err)
+	}
+	defer c.database().Close()
+	if c.FakeIPMetadata() != nil {
+		t.Fatal("fresh store has metadata")
+	}
+	expected := &adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/15"), Inet4Current: netip.MustParseAddr("198.18.0.2")}
+	if err := c.FakeIPSaveMetadata(expected); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.FakeIPStore(expected.Inet4Current, "synthetic.test"); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		if m := c.FakeIPMetadata(); m == nil || *m != *expected {
+			t.Fatal("cursor was consumed or changed", m)
+		}
+	}
+	if err := c.update(func(tx *bbolt.Tx) error { return tx.Bucket(bucketFakeIP).Delete(keyMetadata) }); err != nil {
+		t.Fatal(err)
+	}
+	if m := c.FakeIPMetadata(); m == nil || m.Inet4Range.IsValid() {
+		t.Fatal("lost cursor appeared as fresh state", m)
+	}
+}
