+package cachefile
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"os"
+	"time"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/adapter"
+)
+
+// RetireFakeIP writes a fresh database containing allocation metadata only.
+// The caller owns publication/rollback and must stop the network core first.
+// Deleting buckets in place would leave old domain strings in free DB pages.
+func RetireFakeIP(sourcePath, targetPath string) error {
+	sourceInfo, err := os.Stat(sourcePath)
+	if err != nil {
+		return err
+	}
+	targetInfo, err := os.Stat(targetPath)
+	if err != nil {
+		return err
+	}
+	if !sourceInfo.Mode().IsRegular() || !targetInfo.Mode().IsRegular() || os.SameFile(sourceInfo, targetInfo) || targetInfo.Size() != 0 || sourceInfo.Size() > 32*1024*1024 {
+		return errors.New("invalid FakeIP retirement files")
+	}
+	source, err := bbolt.Open(sourcePath, 0o600, &bbolt.Options{ReadOnly: true, Timeout: time.Second})
+	if err != nil {
+		return err
+	}
+	defer source.Close()
+	var metadataBytes []byte
+	err = source.View(func(tx *bbolt.Tx) error {
+		bucket := tx.Bucket(bucketFakeIP)
+		if bucket != nil {
+			metadataBytes = bytes.Clone(bucket.Get(keyMetadata))
+		}
+		if len(metadataBytes) == 0 {
+			for _, key := range [][]byte{bucketFakeIP, bucketFakeIPDomain4, bucketFakeIPDomain6} {
+				if b := tx.Bucket(key); b != nil {
+					if k, _ := b.Cursor().First(); k != nil {
+						return errors.New("FakeIP cursor missing from nonempty state")
+					}
+				}
+			}
+			return nil // A core that died before issuing any address.
+		}
+		// The upstream decoder panics on truncated length fields. Validate the
+		// framing before decoding, and reject unexpected trailing data.
+		if len(metadataBytes) > 128 {
+			return errors.New("invalid FakeIP cursor size")
+		}
+		remaining := metadataBytes
+		for range 4 {
+			if len(remaining) < 2 {
+				return errors.New("truncated FakeIP cursor")
+			}
+			size := int(binary.BigEndian.Uint16(remaining))
+			remaining = remaining[2:]
+			if size > 17 || len(remaining) < size {
+				return errors.New("invalid FakeIP cursor element")
+			}
+			remaining = remaining[size:]
+		}
+		if len(remaining) != 0 {
+			return errors.New("invalid FakeIP cursor framing")
+		}
+		var metadata adapter.FakeIPMetadata
+		if err := metadata.UnmarshalBinary(metadataBytes); err != nil {
+			return err
+		}
+		for _, pair := range []struct {
+			prefix netip.Prefix
+			cursor netip.Addr
+		}{
+			{metadata.Inet4Range, metadata.Inet4Current}, {metadata.Inet6Range, metadata.Inet6Current},
+		} {
+			if pair.prefix.IsValid() != pair.cursor.IsValid() || (pair.prefix.IsValid() && !pair.prefix.Contains(pair.cursor)) {
+				return errors.New("invalid FakeIP cursor range")
+			}
+		}
+		if !metadata.Inet4Range.IsValid() && !metadata.Inet6Range.IsValid() {
+			return errors.New("missing FakeIP address ranges")
+		}
+		check := func(raw []byte) error {
+			address, ok := netip.AddrFromSlice(raw)
+			prefix, cursor := metadata.Inet6Range, metadata.Inet6Current
+			if address.Is4() {
+				prefix, cursor = metadata.Inet4Range, metadata.Inet4Current
+			}
+			if !ok || !prefix.Contains(address) || cursor.Compare(address) < 0 {
+				return errors.New("FakeIP cursor does not cover retained addresses")
+			}
+			return nil
+		}
+		if err := bucket.ForEach(func(key, value []byte) error {
+			if bytes.Equal(key, keyMetadata) {
+				return nil
+			}
+			if value == nil {
+				return errors.New("unexpected FakeIP bucket")
+			}
+			return check(key)
+		}); err != nil {
+			return err
+		}
+		for _, key := range [][]byte{bucketFakeIPDomain4, bucketFakeIPDomain6} {
+			if b := tx.Bucket(key); b != nil {
+				if err := b.ForEach(func(_, value []byte) error { return check(value) }); err != nil {
+					return err
+				}
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	target, err := bbolt.Open(targetPath, 0o600, &bbolt.Options{Timeout: time.Second})
+	if err != nil {
+		return err
+	}
+	err = target.Update(func(tx *bbolt.Tx) error {
+		if len(metadataBytes) == 0 {
+			return nil
+		}
+		bucket, err := tx.CreateBucket(bucketFakeIP)
+		if err != nil {
+			return err
+		}
+		return bucket.Put(keyMetadata, metadataBytes)
+	})
+	closed := target.Close()
+	if err != nil {
+		return err
+	}
+	return closed
+}
