+)
+
+func TestEivroRetirementCopiesOnlyCursorIntoFreshPages(t *testing.T) {
+	dir := t.TempDir()
+	source, target := filepath.Join(dir, "old.db"), filepath.Join(dir, "new.db")
+	c := New(context.Background(), logger.NOP(), option.CacheFileOptions{Path: source, StoreFakeIP: true})
+	if err := c.start(); err != nil {
+		t.Fatal(err)
+	}
+	metadata := &adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/15"), Inet4Current: netip.MustParseAddr("198.18.0.20"), Inet6Range: netip.MustParsePrefix("2001:2::/111"), Inet6Current: netip.MustParseAddr("2001:2::20")}
+	if err := c.FakeIPSaveMetadata(metadata); err != nil {
+		t.Fatal(err)
+	}
+	for _, address := range []string{"198.18.0.15", "2001:2::15"} {
+		if err := c.FakeIPStore(netip.MustParseAddr(address), "private-retirement-fixture.test"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := c.database().Close(); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.ReadFile(source)
+	if err := os.WriteFile(target, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := RetireFakeIP(source, target); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := os.ReadFile(source)
+	fresh, _ := os.ReadFile(target)
+	if !bytes.Equal(before, after) || !bytes.Contains(before, []byte("private-retirement-fixture.test")) || bytes.Contains(fresh, []byte("private-retirement-fixture.test")) {
+		t.Fatal("retirement changed the source or copied domain records")
+	}
+	next := New(context.Background(), logger.NOP(), option.CacheFileOptions{Path: target, StoreFakeIP: true})
+	if err := next.start(); err != nil {
+		t.Fatal(err)
+	}
+	defer next.database().Close()
+	if got := next.FakeIPMetadata(); got == nil || *got != *metadata {
+		t.Fatal("allocation cursor changed", got)
+	}
+	if _, ok := next.FakeIPLoad(netip.MustParseAddr("198.18.0.15")); ok {
+		t.Fatal("retired address still resolves")
+	}
+}
+
+func TestEivroRetirementRejectsLostTruncatedAndRewoundCursor(t *testing.T) {
+	for _, mode := range []string{"missing", "truncated", "rewound"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			source, target := filepath.Join(dir, "old.db"), filepath.Join(dir, "new.db")
+			db, err := bbolt.Open(source, 0o600, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			err = db.Update(func(tx *bbolt.Tx) error {
+				b, err := tx.CreateBucket(bucketFakeIP)
+				if err != nil {
+					return err
+				}
+				if err = b.Put(netip.MustParseAddr("198.18.0.10").AsSlice(), []byte("fixture.test")); err != nil {
+					return err
+				}
+				if mode == "missing" {
+					return nil
+				}
+				data := []byte{0}
+				if mode == "rewound" {
+					data, err = (&adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/15"), Inet4Current: netip.MustParseAddr("198.18.0.2")}).MarshalBinary()
+					if err != nil {
+						return err
+					}
+				}
+				return b.Put(keyMetadata, data)
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			db.Close()
+			os.WriteFile(target, nil, 0o600)
+			if err := RetireFakeIP(source, target); err == nil {
+				t.Fatal("unsafe cursor accepted")
+			}
+			if info, _ := os.Stat(target); info.Size() != 0 {
+				t.Fatal("target modified before validating source")
+			}
+		})
+	}
+}
