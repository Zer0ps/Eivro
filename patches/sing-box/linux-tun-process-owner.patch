+++ b/protocol/tun/eivro_local_source_linux_test.go
@@ -0,0 +1,70 @@
+//go:build linux && !android
+
+package tun
+
+import (
+	"net"
+	"net/netip"
+	"slices"
+	"testing"
+
+	T "github.com/sagernet/sing-tun"
+	"github.com/sagernet/sing/common/control"
+)
+
+func TestMissingSnapshotRequiresAssignedExactAddress(t *testing.T) {
+	lo, err := net.InterfaceByName("lo")
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := control.InterfaceFromNet(*lo)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(info.Addresses) == 0 {
+		t.Fatal("loopback has no assigned addresses")
+	}
+
+	// Use only existing local addresses. No link, route, socket or sysctl changes.
+	inbound := &Inbound{tunOptions: T.Options{Name: lo.Name}}
+	for _, prefix := range info.Addresses {
+		if prefix.Addr().Is4() {
+			inbound.tunOptions.Inet4Address = append(inbound.tunOptions.Inet4Address, prefix)
+		} else {
+			inbound.tunOptions.Inet6Address = append(inbound.tunOptions.Inet6Address, prefix)
+		}
+	}
+	for _, prefix := range info.Addresses {
+		if !inbound.HasAssignedLocalAddress(prefix.Addr()) {
+			t.Fatalf("missing assigned address %s", prefix.Addr())
+		}
+	}
+	for _, ip := range []string{"127.0.0.2", "2001:db8::77"} {
+		source := netip.MustParseAddr(ip)
+		for slices.ContainsFunc(info.Addresses, func(p netip.Prefix) bool { return p.Addr() == source }) {
+			source = source.Next()
+		}
+		if inbound.HasAssignedLocalAddress(source) {
+			t.Fatalf("accepted unassigned address %s", ip)
+		}
+		// Even an explicitly configured host must still be present on this link.
+		if source.Is4() {
+			inbound.tunOptions.Inet4Address = append(inbound.tunOptions.Inet4Address, netip.PrefixFrom(source, 8))
+		} else {
+			inbound.tunOptions.Inet6Address = append(inbound.tunOptions.Inet6Address, netip.PrefixFrom(source, 64))
+		}
+		if inbound.HasAssignedLocalAddress(source) {
+			t.Fatalf("trusted configuration alone: %s", ip)
+		}
+	}
+	inbound.tunOptions.NetNs = "other"
+	if inbound.HasAssignedLocalAddress(netip.MustParseAddr("127.0.0.1")) {
+		t.Fatal("consulted a different namespace")
+	}
+	inbound.tunOptions.NetNs = ""
+	inbound.tunOptions.Name = "eivro-missing-interface"
+	if inbound.HasAssignedLocalAddress(netip.MustParseAddr("127.0.0.1")) {
+		t.Fatal("accepted missing interface")
+	}
+}
