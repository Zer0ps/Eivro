+++ b/route/eivro_local_source_linux_test.go
@@ -0,0 +1,75 @@
+//go:build linux && !android
+
+package route
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/control"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type testSourceNetwork struct {
+	adapter.NetworkManager
+	finder control.InterfaceFinder
+}
+
+func (n testSourceNetwork) InterfaceFinder() control.InterfaceFinder { return n.finder }
+
+type testSourceTun struct {
+	adapter.Inbound
+	address netip.Addr
+	calls   int
+}
+
+func (t *testSourceTun) HasAssignedLocalAddress(addr netip.Addr) bool {
+	t.calls++
+	return addr == t.address
+}
+
+type testSourceInbounds struct {
+	adapter.InboundManager
+	tun *testSourceTun
+}
+
+func (m testSourceInbounds) Get(tag string) (adapter.Inbound, bool) {
+	if tag == "local-tun" {
+		return m.tun, true
+	}
+	return nil, false
+}
+
+func TestProcessSourceWhileTunnelAddressSnapshotIsStale(t *testing.T) {
+	finder := control.NewDefaultInterfaceFinder()
+	for _, host := range []string{"192.0.2.1", "2001:db8::1"} {
+		ip := netip.MustParseAddr(host)
+		tun := &testSourceTun{address: ip}
+		router := &Router{network: testSourceNetwork{finder: finder}, inbound: testSourceInbounds{tun: tun}}
+		metadata := &adapter.InboundContext{Source: M.Socksaddr{Addr: ip}, Inbound: "local-tun", InboundType: C.TypeTun}
+		finder.UpdateInterfaces([]control.Interface{{Addresses: []netip.Prefix{netip.PrefixFrom(ip, ip.BitLen())}}})
+		if !router.isLocalSource(metadata) || tun.calls != 0 {
+			t.Fatal("cached local address must use fast path")
+		}
+		finder.UpdateInterfaces(nil) // a delayed notification supersedes the good snapshot
+		if !router.isLocalSource(metadata) || tun.calls != 1 {
+			t.Fatal("first TUN flow lost local process lookup")
+		}
+		metadata.Source.Addr = ip.Next()
+		if router.isLocalSource(metadata) {
+			t.Fatal("accepted peer address")
+		}
+		metadata.Source.Addr = ip
+		metadata.Inbound = "other"
+		if router.isLocalSource(metadata) {
+			t.Fatal("borrowed evidence from another inbound")
+		}
+		metadata.Inbound = "local-tun"
+		metadata.InboundType = C.TypeMixed
+		if router.isLocalSource(metadata) || tun.calls != 2 {
+			t.Fatal("consulted TUN for mixed inbound")
+		}
+	}
+}
