+++ b/protocol/tun/eivro_local_source_linux.go
@@ -0,0 +1,34 @@
+//go:build linux && !android
+
+package tun
+
+import (
+	"net"
+	"net/netip"
+	"slices"
+
+	"github.com/sagernet/sing/common/control"
+)
+
+// HasAssignedLocalAddress is the uncommon process-lookup path during TUN
+// reconfiguration. An address permits searching for the socket owner, never
+// attributing a packet to a process without that separate kernel lookup.
+func (t *Inbound) HasAssignedLocalAddress(source netip.Addr) bool {
+	if t.tunOptions.NetNs != "" || t.tunOptions.Name == "" || !source.IsValid() {
+		return false
+	}
+	configured := t.tunOptions.Inet6Address
+	if source.Is4() {
+		configured = t.tunOptions.Inet4Address
+	}
+	exact := func(prefix netip.Prefix) bool { return prefix.Addr() == source }
+	if !slices.ContainsFunc(configured, exact) {
+		return false
+	}
+	nic, err := net.InterfaceByName(t.tunOptions.Name)
+	if err != nil {
+		return false
+	}
+	current, err := control.InterfaceFromNet(*nic)
+	return err == nil && slices.ContainsFunc(current.Addresses, exact)
+}
